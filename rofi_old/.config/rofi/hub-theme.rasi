/* ─────────────────────────────────────────────
   hub-theme.rasi — Dark Glass + Teal/Green
   Import this in every rofi call:
   rofi -theme ~/.config/rofi/hub-theme.rasi
   ───────────────────────────────────────────── */

* {
    /* ── Palette ── */
    bg0:        rgba(14, 20, 18, 0.82);     /* main window bg      — 50% dark */
    bg1:        rgba(255, 255, 255, 0.05);  /* input / item hover  — subtle   */
    bg2:        rgba(255, 255, 255, 0.08);  /* input box bg                   */

    accent0:    rgba(0, 220, 150, 0.50);    /* selected row start  — teal     */
    accent1:    rgba(0, 160, 100, 0.32);    /* selected row end    — green    */
    accent-b:   rgba(0, 210, 140, 0.40);    /* selected row border            */
    accent-fg:  rgba(180, 255, 230, 0.22);  /* prompt icon tint               */

    border0:    rgba(0, 210, 140, 0.18);    /* window border       — faint    */
    border1:    rgba(0, 210, 140, 0.35);    /* input border                   */

    fg0:        rgba(220, 255, 245, 0.92);  /* primary text                   */
    fg1:        rgba(180, 225, 210, 0.70);  /* secondary / unselected text    */
    fg2:        rgba(140, 200, 180, 0.50);  /* placeholder / hint             */

    /* ── Reset ── */
    background-color:   transparent;
    text-color:         @fg0;
    border-color:       @border0;
}

/* ── Window ── */
window {
    background-color:   @bg0;
    border:             1px;
    border-color:       @border0;
    border-radius:      16px;
    padding:            10px;
}

/* ── Input bar ── */
mainbox {
    background-color:   transparent;
    spacing:            8px;
    children:           [ inputbar, listview ];
}

inputbar {
    background-color:   @bg2;
    border:             1px;
    border-color:       @border1;
    border-radius:      10px;
    padding:            11px 14px;
    spacing:            10px;
    children:           [ prompt, entry ];
}

prompt {
    background-color:   transparent;
    text-color:         rgba(0, 220, 150, 0.90);
    font:               "JetBrainsMono Nerd Font 13";
}

entry {
    background-color:   transparent;
    text-color:         @fg0;
    placeholder-color:  @fg2;
    placeholder:        "type to search...";
    cursor:             text;
}

/* ── List ── */
listview {
    background-color:   transparent;
    spacing:            4px;
    scrollbar:          false;
    fixed-height:       false;
    padding:            4px 0px;
}

/* ── Each row ── */
element {
    background-color:   transparent;
    border:             1px;
    border-color:       transparent;
    border-radius:      10px;
    padding:            12px 16px;
    spacing:            12px;
    orientation:        horizontal;
}

element normal.normal {
    background-color:   transparent;
    text-color:         @fg1;
}

element normal.urgent,
element normal.active {
    background-color:   transparent;
    text-color:         @fg0;
}

element selected.normal {
    background-color:   linear-gradient(to right, @accent0, @accent1);
    border-color:       @accent-b;
    text-color:         @fg0;
}

element alternate.normal {
    background-color:   transparent;
    text-color:         @fg1;
}

element-icon {
    background-color:   transparent;
    size:               24px;
}

element-text {
    background-color:   transparent;
    text-color:         inherit;
    highlight:          bold rgba(0, 220, 150, 0.90);
    vertical-align:     0.5;
}

/* ── Scrollbar (hidden but defined cleanly) ── */
scrollbar {
    background-color:   transparent;
    handle-color:       rgba(0, 210, 140, 0.30);
    handle-width:       4px;
    border:             0px;
}
